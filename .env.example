# Secret key for session/token signing
SECRET_KEY=your-secret-key-here

# K2-Think-v2 API key (https://api.k2think.ai)
K2_API_KEY=your-k2think-api-key

# Hack Club Search API key (https://search.hackclub.com) - used by the
# query_hackclub MCP tool for CVE / vulnerability lookups. Format: sk-hc-v1-...
HACKCLUB_API_KEY=your-hackclub-api-key

# Database connection URL (default: SQLite with async driver)
DATABASE_URL=sqlite+aiosqlite:///./threatweaver.db

# Directory where generated PDF vulnerability reports are written.
REPORT_DIR=/tmp/threatweaver/reports

# TEMPORARY: auto-accept domain verification (bypass DNS/HTTP checks).
# Set to "true" to unblock scanning while the real verification flow is fixed.
# WARNING: leaves DAST unlocked for any target - disable before production.
MOCK_VERIFICATION=false
