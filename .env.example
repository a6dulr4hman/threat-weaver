# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Create a free Clerk application at https://clerk.com and copy these values
# from Dashboard → API Keys.
#
# Publishable key (safe to expose in frontend HTML)
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
#
# Secret key (server-side only — never expose to the browser)
CLERK_SECRET_KEY=sk_test_your-secret-key-here

# ─── Core ─────────────────────────────────────────────────────────────────────
# Secret key for nonce / session signing
SECRET_KEY=your-secret-key-here

# K2-Think-v2 API key (https://api.k2think.ai)
K2_API_KEY=your-k2think-api-key

# Hack Club Search API key — used for CVE lookups. Format: sk-hc-v1-...
HACKCLUB_API_KEY=your-hackclub-api-key

# Database connection URL (default: SQLite with async driver)
DATABASE_URL=sqlite+aiosqlite:///./threatweaver.db

# Directory where generated PDF vulnerability reports are written.
REPORT_DIR=/tmp/threatweaver/reports

# Wall-clock budget per scan cycle in seconds (default 300 = 5 minutes).
CYCLE_BUDGET_SECONDS=300

# TEMPORARY: auto-accept domain verification (bypass DNS/HTTP checks).
# WARNING: leaves DAST unlocked for any target — disable before production.
MOCK_VERIFICATION=false
