# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Create a free Clerk application at https://clerk.com and copy these values
# from Dashboard → API Keys.
#
# Publishable key (safe to expose in frontend HTML)
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
#
# Secret key (server-side only — never expose to the browser)
CLERK_SECRET_KEY=sk_test_your-secret-key-here

# ─── Core ─────────────────────────────────────────────────────────────────────
# Secret key for nonce / session signing
SECRET_KEY=your-secret-key-here

# K2-Think-v2 API key (https://api.k2think.ai)
K2_API_KEY=your-k2think-api-key

# Optional SECONDARY K2-Think-v2 API key. When set, the remediation patch set is
# generated concurrently (using this key) while the main key drives report
# generation — see "Concurrent GitHub PR Automation". Leave blank to disable.
K2_API_KEY_2=

# ─── GitHub PR Automation ─────────────────────────────────────────────────────
# Personal Access Token (with "repo" scope) the bot uses to open remediation
# pull requests on the target repository. Leave blank to disable PR automation.
GITHUB_PAT=
# Target repository to open remediation PRs against, as "owner/repo".
# Example: GITHUB_TARGET_REPO=a6dulr4hman/nimbus-crm
GITHUB_TARGET_REPO=

# Hack Club Search API key — used for CVE lookups. Format: sk-hc-v1-...
HACKCLUB_API_KEY=your-hackclub-api-key

# Database connection URL (default: SQLite with async driver)
DATABASE_URL=sqlite+aiosqlite:///./threatweaver.db

# Directory where generated PDF vulnerability reports are written.
REPORT_DIR=/tmp/threatweaver/reports

# Wall-clock budget per scan cycle in seconds (default 300 = 5 minutes).
CYCLE_BUDGET_SECONDS=300

# CORS — comma-separated list of allowed origins for cross-origin API calls.
# Set to your public hostname when running behind a reverse proxy.
# Example: CORS_ORIGINS=https://threatweaver.falak.me
CORS_ORIGINS=




# Comma-separated domains that skip DNS verification entirely (pre-approved).
# threat.falak.me is always whitelisted by default.
# Add more domains here if needed: VERIFIED_DOMAINS=threat.falak.me,other.example.com
VERIFIED_DOMAINS=threat.falak.me

# Set true to bypass ALL domain verification (demo/dev only — never in production).
MOCK_VERIFICATION=false
